	<!-- ==================== Artillery ==================== -->

	<ThingDef ParentName="BaseArtilleryWeapon">
		<defName>ABT_Gun_Artillery</defName>
		<label>artillery</label>
		<description>high caliber artillery gun meant for long range engagements.</description>
		<graphicData>
			<texPath>Things/Building/Turrets/Industrial/Artillery</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Artillery_ShellLoaded</soundInteract>
		<statBases>
			<SightsEfficiency>0.5</SightsEfficiency>
			<RangedWeapon_Cooldown>2.7</RangedWeapon_Cooldown>
			<Mass>100</Mass>
		</statBases>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<verbClass>CombatExtended.Verb_ShootMortarCE</verbClass>
				<forceNormalTimeSpeed>false</forceNormalTimeSpeed>
				<hasStandardCommand>true</hasStandardCommand>
				<requireLineOfSight>false</requireLineOfSight>
				<defaultProjectile>Bullet_105mmHowitzerShell_HE</defaultProjectile>
				<warmupTime>4</warmupTime>
				<minRange>20</minRange>
				<range>900</range>
				<burstShotCount>1</burstShotCount>
				<soundCast>120mm</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>50</muzzleFlashScale>
				<indirectFirePenalty>0.3</indirectFirePenalty>
				<circularError>1</circularError>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_Charges">
				<chargeSpeeds>
					<li>30</li>
					<li>50</li>
					<li>70</li>
					<li>90</li>
				</chargeSpeeds>
			</li>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>1</magazineSize>
				<reloadTime>5</reloadTime>
				<ammoSet>AmmoSet_105mmHowitzerShell</ammoSet>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="BaseArtilleryBuilding">
		<defName>ABT_Turret_Artillery</defName>
		<label>artillery</label>
		<description>A high caliber artillery piece for indirect fire at extended ranges.</description>
		<thingClass>CombatExtended.Building_TurretGunCE</thingClass>
		<constructionSkillPrerequisite>7</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/Turrets/Industrial/Artillery_base</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,0)</offset>
			</shadowData>
			<drawSize>(4,4)</drawSize>
		</graphicData>
		<uiIconPath>Things/Building/Turrets/Industrial/Artillery_uiIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>400</MaxHitPoints>
			<Flammability>0.5</Flammability>
			<WorkToBuild>17000</WorkToBuild>
			<Mass>150</Mass>
			<Bulk>100</Bulk>
		</statBases>
		<costList>
			<Steel>300</Steel>
			<ComponentIndustrial>8</ComponentIndustrial>
		</costList>
		<costStuffCount />
		<costListForDifficulty>
			<difficultyVar>classicMortars</difficultyVar>
			<invert>true</invert>
			<costList>
				<ComponentIndustrial>8</ComponentIndustrial>
				<ReinforcedBarrel>1</ReinforcedBarrel>
				<Steel>150</Steel>
			</costList>
		</costListForDifficulty>
		<building>
			<turretTopDrawSize>4</turretTopDrawSize>
			<turretGunDef>ABT_Gun_Artillery</turretGunDef>
			<ai_combatDangerous>true</ai_combatDangerous>
			<turretBurstCooldownTime>2.7</turretBurstCooldownTime>
		</building>
		<placeWorkers>
			<li>PlaceWorker_NotUnderRoof</li>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_PreventInteractionSpotOverlap</li>
		</placeWorkers>
		<size>(1,1)</size>
		<fillPercent>0.85</fillPercent>
		<stuffCategories Inherit="False" />
		<terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Bamba_Turret_Research_Industrial</li>
		</researchPrerequisites>
		<minifiedDef>MinifiedThing</minifiedDef>
		<designationCategory>Security</designationCategory>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
	</ThingDef>

</Defs>
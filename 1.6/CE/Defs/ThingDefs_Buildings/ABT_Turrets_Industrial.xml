<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- ==================== Microgun ==================== -->

	<ThingDef ParentName="BaseTurretGun">
		<defName>ABT_Gun_Microgun</defName>
		<label>microgun</label>
		<graphicData>
			<texPath>Things/Building/Turrets/Industrial/Gun</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>Automated rotary machine gun for use against infantry and lightly armored targets.</description>
		<statBases>
			<Mass>10</Mass>
			<ShotSpread>0.09</ShotSpread>
			<SwayFactor>0.81</SwayFactor>
			<SightsEfficiency>1.0</SightsEfficiency>
			<RangedWeapon_Cooldown>0.35</RangedWeapon_Cooldown>
		</statBases>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>0.64</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_556x45mmNATO_FMJ</defaultProjectile>
				<warmupTime>2.1</warmupTime>
				<range>62</range>
				<burstShotCount>25</burstShotCount>
				<ticksBetweenBurstShots>2</ticksBetweenBurstShots>
				<soundCast>Shot_AssaultRifle</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
				<recoilPattern>Mounted</recoilPattern>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>500</magazineSize>
				<reloadTime>9.2</reloadTime>
				<ammoSet>AmmoSet_556x45mmNATO</ammoSet>
			</li>
			<li Class="CombatExtended.CompProperties_FireModes">
				<aimedBurstShotCount>10</aimedBurstShotCount>
				<aiAimMode>Snapshot</aiAimMode>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="TurretAutoBase">
		<defName>ABT_Turret_Microgun</defName>
		<label>microgun</label>
		<constructionSkillPrerequisite>7</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/Turrets/Industrial/Industrial_base</texPath>
			<drawSize>(2,2)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,0)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Building/Turrets/Industrial/Gun_uiIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>175</MaxHitPoints>
			<Flammability>0.5</Flammability>
			<WorkToBuild>28000</WorkToBuild>
			<Mass>20</Mass>
			<Bulk>30</Bulk>
			<AimingAccuracy>0.75</AimingAccuracy>
			<ShootingAccuracyTurret>1.25</ShootingAccuracyTurret>
		</statBases>
		<description>Automated rotary machine gun mounted on a quadpod.</description>
		<costList>
			<Steel>200</Steel>
			<ComponentIndustrial>12</ComponentIndustrial>
		</costList>
		<building>
			<turretGunDef>ABT_Gun_Microgun</turretGunDef>
			<ai_combatDangerous>true</ai_combatDangerous>
		</building>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>150</basePowerConsumption>
			</li>
		</comps>
		<researchPrerequisites>
			<li>Bamba_Turret_Research_Industrial</li>
		</researchPrerequisites>
		<minifiedDef>MinifiedThing</minifiedDef>
	</ThingDef>

	<!-- ==================== EMP MG ==================== -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_20x42mmGrenadeEMP</defName>

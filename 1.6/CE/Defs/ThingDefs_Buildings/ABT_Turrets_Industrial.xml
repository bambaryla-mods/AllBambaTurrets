	<!-- ==================== Rocket ==================== -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_50mmRocket_Direct</defName>
		<label>50mm rocket</label>
		<ammoTypes>
			<Ammo_50mmRocket_HE>Bullet_50mmRocket_Direct</Ammo_50mmRocket_HE>
		</ammoTypes>
	</CombatExtended.AmmoSetDef>

	<ThingDef ParentName="BaseExplosiveBullet">
		<defName>Bullet_50mmRocket_Direct</defName>
		<thingClass>CombatExtended.ProjectileCE_Explosive</thingClass>
		<label>50mm rocket (HE)</label>
		<graphicData>
			<texPath>Things/Projectile/Rocket/70mmAPKWS</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<drawSize>0.70</drawSize>
			<shaderType>TransparentPostLight</shaderType>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<speed>60</speed>
			<damageDef>Bomb</damageDef>
			<damageAmountBase>147</damageAmountBase>
			<explosionRadius>2.5</explosionRadius>
			<soundAmbient>RocketPropelledLoop_Small</soundAmbient>
		</projectile>
		<comps>
			<li Class="CombatExtended.CompProperties_Fragments">
				<fragments>
					<Fragment_Small>23</Fragment_Small>
				</fragments>
			</li>
			<li Class="CombatExtended.CompProperties_ProjectileFleck">
				<FleckDatas>
					<li>
						<fleck>Fleck_CERocketFlame</fleck>
						<emissionsPerTick>7</emissionsPerTick>
						<flecksPerEmission>3</flecksPerEmission>
						<cutoffTickRange>60~120</cutoffTickRange>
					</li>
					<li>
						<fleck>Fleck_CERocketSmokeTrail</fleck>
						<emissionsPerTick>0.5</emissionsPerTick>
						<rotation>0~360</rotation>
						<scale>2</scale>
						<flecksPerEmission>1</flecksPerEmission>
					</li>
					<li>
						<fleck>Fleck_CERocketSmoke</fleck>
						<emissionsPerTick>0.5</emissionsPerTick>
						<rotation>0~360</rotation>
						<flecksPerEmission>1</flecksPerEmission>
						<cutoffTickRange>120~240</cutoffTickRange>
					</li>
				</FleckDatas>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="BaseTurretGun">
		<defName>ABT_Gun_Rocket</defName>
		<label>rocket launcher</label>
		<graphicData>
			<texPath>Things/Building/Turrets/Industrial/AoE</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>Automated rocket launcher for use against armored targets.</description>
		<statBases>
			<Mass>15</Mass>
			<ShotSpread>0.1</ShotSpread>
			<SwayFactor>1.0</SwayFactor>
			<SightsEfficiency>1.0</SightsEfficiency>
			<RangedWeapon_Cooldown>0.38</RangedWeapon_Cooldown>
		</statBases>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>1.5</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_50mmRocket_Direct</defaultProjectile>
				<warmupTime>3.0</warmupTime>
				<range>62</range>
				<minRange>3</minRange>
				<burstShotCount>4</burstShotCount>
				<ticksBetweenBurstShots>9</ticksBetweenBurstShots>
				<soundCast>RocketswarmLauncher_Fire</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>39</muzzleFlashScale>
				<recoilPattern>Mounted</recoilPattern>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>4</magazineSize>
				<reloadTime>6.5</reloadTime>
				<ammoSet>AmmoSet_50mmRocket_Direct</ammoSet>
			</li>
			<li Class="CombatExtended.CompProperties_FireModes">
				<aimedBurstShotCount>2</aimedBurstShotCount>
				<aiAimMode>AimedShot</aiAimMode>
			</li>
		</comps>
	</ThingDef>


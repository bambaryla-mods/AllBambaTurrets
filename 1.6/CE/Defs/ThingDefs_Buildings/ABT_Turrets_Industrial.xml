		<graphicData>
			<texPath>Things/Building/Turrets/Industrial/EMP</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>Automated EMP heavy machine gun for use against targets susceptible to EMP damage.</description>
		<statBases>
			<Mass>15</Mass>
			<ShotSpread>0.05</ShotSpread>

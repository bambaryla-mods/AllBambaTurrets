<Defs>

	<!-- ==================== Charge Microgun ==================== -->

	<ThingDef ParentName="BaseBullet">
		<defName>Bullet_6x18mmCharged</defName>
		<label>6x18mm Charged</label>
		<graphicData>
			<texPath>Things/Projectile/Charge_Small</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>13</damageAmountBase>
			<armorPenetrationBase>0.3</armorPenetrationBase>
			<speed>122</speed>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="BaseWeaponTurret">
		<defName>ABT_Gun_CM</defName>
		<label>charge microgun</label>
		<graphicData>
			<texPath>Things/Building/Turrets/Spacer/Gun</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>Automated charge-shot rotary machine gun for use against infantry and lightly armored targets.</description>
		<statBases>
			<Mass>8</Mass>
			<AccuracyTouch>0.25</AccuracyTouch>
			<AccuracyShort>0.35</AccuracyShort>
			<AccuracyMedium>0.35</AccuracyMedium>
			<AccuracyLong>0.28</AccuracyLong>
			<RangedWeapon_Cooldown>2.0</RangedWeapon_Cooldown>
			<DeteriorationRate>0</DeteriorationRate>
			<Flammability>0</Flammability>
		</statBases>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_6x18mmCharged</defaultProjectile>
				<warmupTime>2.2</warmupTime>
				<range>32.9</range>
				<burstShotCount>25</burstShotCount>
				<ticksBetweenBurstShots>1</ticksBetweenBurstShots>
				<soundCast>Shot_ChargeBlaster</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
				<consumeFuelPerShot>1</consumeFuelPerShot>
			</li>
		</verbs>
	</ThingDef>

	<ThingDef ParentName="ABT_TurretBase">
		<defName>ABT_Turret_CM</defName>
		<label>charge microgun</label>
		<constructionSkillPrerequisite>9</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/Turrets/Spacer/Spacer_base</texPath>
			<drawSize>(2,2)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,0)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Building/Turrets/Spacer/Gun_uiIcon</uiIconPath>
		<hasInteractionCell>False</hasInteractionCell>
		<statBases>
			<MaxHitPoints>250</MaxHitPoints>
			<WorkToBuild>38000</WorkToBuild>
			<Mass>15</Mass>
			<ShootingAccuracyTurret>0.98</ShootingAccuracyTurret>
		</statBases>
		<description>Automated charge rotary machine gun mounted on a quadpod.</description>
		<costList>
			<Steel>175</Steel>
			<Plasteel>50</Plasteel>
			<ComponentIndustrial>7</ComponentIndustrial>
			<ComponentSpacer>1</ComponentSpacer>
		</costList>
		<building>
			<turretGunDef>ABT_Gun_CM</turretGunDef>
			<ai_combatDangerous>true</ai_combatDangerous>
		</building>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
		<comps Inherit="false">
			<li Class="CompProperties_Forbiddable" />
			<li Class="CompProperties_Flickable" />
			<li Class="CompProperties_Breakdownable" />
			<li Class="CompProperties_Refuelable">
				<fuelLabel>Shots until relaod</fuelLabel>
				<fuelGizmoLabel>Remaining ammo</fuelGizmoLabel>
				<outOfFuelMessage>Needs reloading</outOfFuelMessage>
				<fuelFilter>
					<thingDefs>
						<li>Plasteel</li>
					</thingDefs>
				</fuelFilter>
				<fuelCapacity>1000</fuelCapacity>
				<fuelMultiplier>62</fuelMultiplier>
				<initialFuelPercent>0</initialFuelPercent>
				<autoRefuelPercent>0.5</autoRefuelPercent>
				<showFuelGizmo>true</showFuelGizmo>
				<minimumFueledThreshold>1</minimumFueledThreshold>
				<factorByDifficulty>true</factorByDifficulty>
				<consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
				<fuelIconPath>UI/Overlays/Barrel</fuelIconPath>
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>300</basePowerConsumption>
			</li>
			<li Class="CompProperties_Stunnable">
				<affectedDamageDefs>
					<li>EMP</li>
				</affectedDamageDefs>
			</li>
		</comps>
		<researchPrerequisites>
			<li>Bamba_Turret_Research_Spacer</li>
		</researchPrerequisites>
		<minifiedDef>MinifiedThing</minifiedDef>
	</ThingDef>


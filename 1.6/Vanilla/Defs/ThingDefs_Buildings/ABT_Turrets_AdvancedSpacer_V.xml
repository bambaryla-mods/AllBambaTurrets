<Defs>

	<!-- ==================== Charge Microgun ==================== -->

	<ThingDef ParentName="BaseBullet">
		<defName>Bullet_6x24mmCharged</defName>
		<label>6x24mm Charged</label>
		<graphicData>
			<texPath>Things/Projectile/Charge_Small</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<projectile>
			<damageDef>Bullet</damageDef>
			<damageAmountBase>15</damageAmountBase>
			<armorPenetrationBase>0.35</armorPenetrationBase>
			<speed>151</speed>
		</projectile>
	</ThingDef>

	<ThingDef ParentName="BaseWeaponTurret">
		<defName>ABT_Gun_ACM</defName>
		<label>advanced charge microgun</label>
		<graphicData>
			<texPath>Things/Building/Turrets/AdvSpacer/Gun</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>Automated advanced charge-shot rotary machine gun for use against infantry and lightly armored targets.</description>
		<statBases>
			<Mass>10</Mass>
			<AccuracyTouch>0.27</AccuracyTouch>
			<AccuracyShort>0.37</AccuracyShort>
			<AccuracyMedium>0.38</AccuracyMedium>
			<AccuracyLong>0.3</AccuracyLong>
			<RangedWeapon_Cooldown>2.0</RangedWeapon_Cooldown>
			<DeteriorationRate>0</DeteriorationRate>
			<Flammability>0</Flammability>
		</statBases>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_6x24mmCharged</defaultProjectile>
				<warmupTime>2.1</warmupTime>
				<range>33.9</range>
				<burstShotCount>25</burstShotCount>
				<ticksBetweenBurstShots>1</ticksBetweenBurstShots>
				<soundCast>Shot_ChargeBlaster</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
				<consumeFuelPerShot>1</consumeFuelPerShot>
			</li>
		</verbs>
	</ThingDef>

	<ThingDef ParentName="ABT_TurretBase">
		<defName>ABT_Turret_ACM</defName>
		<label>advanced charge microgun</label>
		<constructionSkillPrerequisite>10</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/Turrets/AdvSpacer/AdvSpacer_base</texPath>
			<drawSize>(2,2)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,0)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Building/Turrets/AdvSpacer/Gun_uiIcon</uiIconPath>
		<hasInteractionCell>False</hasInteractionCell>
		<statBases>
			<MaxHitPoints>275</MaxHitPoints>
			<WorkToBuild>40000</WorkToBuild>
			<Mass>20</Mass>
			<ShootingAccuracyTurret>0.99</ShootingAccuracyTurret>
		</statBases>
		<description>Automated advanced charge rotary machine gun mounted on a quadpod.</description>
		<costList>
			<Steel>200</Steel>
			<Plasteel>50</Plasteel>
			<ComponentIndustrial>7</ComponentIndustrial>
			<ComponentSpacer>1</ComponentSpacer>
		</costList>
		<building>
			<turretGunDef>ABT_Gun_ACM</turretGunDef>
			<ai_combatDangerous>true</ai_combatDangerous>
		</building>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
		<comps Inherit="false">
			<li Class="CompProperties_Forbiddable" />
			<li Class="CompProperties_Flickable" />
			<li Class="CompProperties_Breakdownable" />
			<li Class="CompProperties_Refuelable">
				<fuelLabel>Shots until relaod</fuelLabel>
				<fuelGizmoLabel>Remaining ammo</fuelGizmoLabel>
				<outOfFuelMessage>Needs reloading</outOfFuelMessage>
				<fuelFilter>
					<thingDefs>
						<li>Plasteel</li>
					</thingDefs>
				</fuelFilter>
				<fuelCapacity>1000</fuelCapacity>
				<fuelMultiplier>62</fuelMultiplier>
				<initialFuelPercent>0</initialFuelPercent>
				<autoRefuelPercent>0.5</autoRefuelPercent>
				<showFuelGizmo>true</showFuelGizmo>
				<minimumFueledThreshold>1</minimumFueledThreshold>
				<factorByDifficulty>true</factorByDifficulty>
				<consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
				<fuelIconPath>UI/Overlays/Barrel</fuelIconPath>
			</li>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>325</basePowerConsumption>
			</li>
			<li Class="CompProperties_Stunnable">
				<affectedDamageDefs>
					<li>EMP</li>
				</affectedDamageDefs>
			</li>
		</comps>
		<researchPrerequisites>
			<li>Bamba_Turret_Research_Ultra</li>
		</researchPrerequisites>
		<minifiedDef>MinifiedThing</minifiedDef>
	</ThingDef>


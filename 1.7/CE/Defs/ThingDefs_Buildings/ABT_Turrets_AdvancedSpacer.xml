<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- Ultra turrets. Their ammo is in ../Ammo/ABT_Ammo_Ultra.xml. -->

	<!-- ==================== Ultra Charge Microgun ==================== -->

	<ThingDef ParentName="BaseTurretGun">
		<defName>ABT_Gun_ACM</defName>
		<label>ultra charge microgun</label>
		<graphicData>
			<texPath>Things/Building/Turrets/AdvSpacer/Gun</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>Automated ultra charge-shot rotary machine gun. Its heavy charged rounds hit hard and wear armor down rather than punching through it.</description>
		<statBases>
			<Mass>10</Mass>
			<ShotSpread>0.08</ShotSpread>
			<SwayFactor>0.78</SwayFactor>
			<SightsEfficiency>2.0</SightsEfficiency>
			<RangedWeapon_Cooldown>0.35</RangedWeapon_Cooldown>
		</statBases>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>0.6</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_8x40mmUltraCharged</defaultProjectile>
				<warmupTime>2.1</warmupTime>
				<range>65</range>
				<burstShotCount>25</burstShotCount>
				<ticksBetweenBurstShots>1</ticksBetweenBurstShots>
				<soundCast>Shot_ChargeBlaster</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
				<recoilPattern>Mounted</recoilPattern>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>1000</magazineSize>
				<reloadTime>9.2</reloadTime>
				<ammoSet>AmmoSet_8x40mmUltraCharged</ammoSet>
			</li>
			<li Class="CombatExtended.CompProperties_FireModes">
				<aimedBurstShotCount>10</aimedBurstShotCount>
				<aiAimMode>Snapshot</aiAimMode>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="TurretAutoBase">
		<defName>ABT_Turret_ACM</defName>
		<label>ultra charge microgun</label>
		<size>(2,2)</size>
		<constructionSkillPrerequisite>10</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/Turrets/AdvSpacer/AdvSpacer_base</texPath>
			<drawSize>(2,2)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,0)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Building/Turrets/AdvSpacer/Gun_uiIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>275</MaxHitPoints>
			<Flammability>0.5</Flammability>
			<WorkToBuild>40000</WorkToBuild>
			<Mass>20</Mass>
			<Bulk>35</Bulk>
			<AimingAccuracy>0.85</AimingAccuracy>
			<ShootingAccuracyTurret>1.5</ShootingAccuracyTurret>
			<NightVisionEfficiency>0.6</NightVisionEfficiency>
		</statBases>
		<description>Automated ultra charge rotary machine gun mounted on a quadpod.</description>
		<costList>
			<Steel>200</Steel>
			<Plasteel>50</Plasteel>
			<ComponentIndustrial>7</ComponentIndustrial>
			<ComponentSpacer>1</ComponentSpacer>
		</costList>
		<building>
			<turretGunDef>ABT_Gun_ACM</turretGunDef>
			<ai_combatDangerous>true</ai_combatDangerous>
		</building>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>325</basePowerConsumption>
			</li>
		</comps>
		<researchPrerequisites>
			<li>Bamba_Turret_Research_Ultra</li>
		</researchPrerequisites>
		<minifiedDef>MinifiedThing</minifiedDef>
	</ThingDef>

	<!-- ==================== Ultra Charge EMP ==================== -->

	<ThingDef ParentName="BaseTurretGun">
		<defName>ABT_Gun_ACEMP</defName>
		<label>ultra charge EMP machine gun</label>
		<graphicData>
			<texPath>Things/Building/Turrets/AdvSpacer/EMP</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>Automated ultra charge EMP machine gun for use against targets susceptible to EMP damage.</description>
		<statBases>
			<Mass>15</Mass>
			<ShotSpread>0.01</ShotSpread>
			<SwayFactor>1.12</SwayFactor>
			<SightsEfficiency>2.0</SightsEfficiency>
			<RangedWeapon_Cooldown>0.36</RangedWeapon_Cooldown>
		</statBases>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>0.89</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_8x40mmUltraCharged_Ion</defaultProjectile>
				<warmupTime>1.2</warmupTime>
				<range>72</range>
				<burstShotCount>10</burstShotCount>
				<ticksBetweenBurstShots>2</ticksBetweenBurstShots>
				<soundCast>ChargeLance_Fire</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
				<recoilPattern>Mounted</recoilPattern>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>200</magazineSize>
				<reloadTime>9.2</reloadTime>
				<ammoSet>AmmoSet_8x40mmUltraChargedIon</ammoSet>
			</li>
			<li Class="CombatExtended.CompProperties_FireModes">
				<aimedBurstShotCount>5</aimedBurstShotCount>
				<aiAimMode>Snapshot</aiAimMode>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="TurretAutoBase">
		<defName>ABT_Turret_ACEMP</defName>
		<label>ultra charge EMP machine gun</label>
		<size>(2,2)</size>
		<constructionSkillPrerequisite>10</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/Turrets/AdvSpacer/AdvSpacer_base</texPath>
			<drawSize>(2,2)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.5)</volume>
				<offset>(0,0,0)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Building/Turrets/AdvSpacer/EMP_uiIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>325</MaxHitPoints>
			<WorkToBuild>48000</WorkToBuild>
			<Mass>30</Mass>
			<Bulk>50</Bulk>
			<AimingAccuracy>0.85</AimingAccuracy>
			<ShootingAccuracyTurret>1.5</ShootingAccuracyTurret>
			<NightVisionEfficiency>0.6</NightVisionEfficiency>
		</statBases>
		<description>Ultra charge EMP machine gun mounted on a quadpod.</description>
		<costList>

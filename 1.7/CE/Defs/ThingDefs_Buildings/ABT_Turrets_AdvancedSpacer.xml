		</researchPrerequisites>
		<minifiedDef>MinifiedThing</minifiedDef>
	</ThingDef>

	<!-- ==================== Ultra Plasma Launcher ==================== -->

	<ThingDef ParentName="BaseTurretGun">
		<defName>ABT_Gun_CRocket</defName>
		<label>ultra plasma launcher</label>
		<graphicData>
			<texPath>Things/Building/Turrets/AdvSpacer/AoE</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>Automated plasma cannon for use against armored targets. Like a tank gun, it fires one heavy bolt at a time: each burns through heavy armor and bursts into plasma around the point of impact.</description>
		<statBases>
			<Mass>15</Mass>
			<ShotSpread>0.04</ShotSpread>
			<SwayFactor>1.0</SwayFactor>
			<SightsEfficiency>2.0</SightsEfficiency>
			<RangedWeapon_Cooldown>3.0</RangedWeapon_Cooldown>
		</statBases>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>2.0</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_UltraPlasmaCell</defaultProjectile>
				<warmupTime>2.5</warmupTime>
				<range>72</range>
				<minRange>4</minRange>
				<burstShotCount>1</burstShotCount>
				<soundCast>ChargeLance_Fire</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>30</muzzleFlashScale>
				<recoilPattern>Mounted</recoilPattern>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>8</magazineSize>
				<reloadTime>6.5</reloadTime>
				<ammoSet>AmmoSet_UltraPlasmaCell</ammoSet>
			</li>
			<li Class="CombatExtended.CompProperties_FireModes">
				<aimedBurstShotCount>1</aimedBurstShotCount>
				<aiUseBurstMode>false</aiUseBurstMode>
				<aiAimMode>AimedShot</aiAimMode>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="TurretAutoBase">
		<defName>ABT_Turret_CRocket</defName>
		<label>ultra plasma launcher</label>
		<size>(4,4)</size>
		<constructionSkillPrerequisite>9</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/Turrets/AdvSpacer/AdvSpacer_base</texPath>
			<drawSize>(5,5)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.5)</volume>
				<offset>(0,0,0)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Building/Turrets/AdvSpacer/AoE_uiIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>325</MaxHitPoints>
			<WorkToBuild>48000</WorkToBuild>
			<Mass>30</Mass>
			<Bulk>50</Bulk>
			<AimingAccuracy>1.0</AimingAccuracy>
			<ShootingAccuracyTurret>1.5</ShootingAccuracyTurret>
			<NightVisionEfficiency>0.6</NightVisionEfficiency>
		</statBases>
		<description>Automated plasma cannon mounted on a quadpod. It fires one heavy bolt every few seconds.</description>
		<costList>
			<Steel>275</Steel>
			<Plasteel>75</Plasteel>
			<ComponentIndustrial>7</ComponentIndustrial>
			<ComponentSpacer>1</ComponentSpacer>
		</costList>
		<building>
			<turretTopDrawSize>5</turretTopDrawSize>
			<turretGunDef>ABT_Gun_CRocket</turretGunDef>
			<ai_combatDangerous>true</ai_combatDangerous>
			<!-- One heavy bolt, then 3 s to recharge: 5.5 s per shot with the 2.5 s warmup -->
			<turretBurstCooldownTime>3.0</turretBurstCooldownTime>
		</building>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>375</basePowerConsumption>
			</li>
			<li Class="CompProperties_Flickable" />
			<li Class="CompProperties_Breakdownable" />
		</comps>
		<researchPrerequisites>
			<li>Bamba_Turret_Research_Ultra</li>
		</researchPrerequisites>
		<minifiedDef>MinifiedThing</minifiedDef>
	</ThingDef>

	<!-- ==================== Ultra Plasma Artillery ==================== -->

	<ThingDef ParentName="BaseArtilleryWeapon">
		<defName>ABT_Gun_AdvChargeArtillery</defName>
		<label>ultra plasma artillery</label>
		<description>Plasma artillery gun meant for long range engagements. Its shells burst into balls of plasma.</description>
		<graphicData>
			<texPath>Things/Building/Turrets/AdvSpacer/Artillery</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<soundInteract>Artillery_ShellLoaded</soundInteract>
		<statBases>
			<SightsEfficiency>0.75</SightsEfficiency>
			<RangedWeapon_Cooldown>2.7</RangedWeapon_Cooldown>
			<Mass>100</Mass>
		</statBases>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<verbClass>CombatExtended.Verb_ShootMortarCE</verbClass>
				<forceNormalTimeSpeed>false</forceNormalTimeSpeed>
				<hasStandardCommand>true</hasStandardCommand>
				<requireLineOfSight>false</requireLineOfSight>
				<defaultProjectile>Bullet_UltraPlasmaShell</defaultProjectile>
				<warmupTime>4</warmupTime>
				<minRange>20</minRange>
				<range>900</range>
				<burstShotCount>2</burstShotCount>
				<ticksBetweenBurstShots>9</ticksBetweenBurstShots>
				<soundCast>InfernoCannon_Fire</soundCast>
				<soundCastTail>GunTail_Heavy</soundCastTail>
				<muzzleFlashScale>50</muzzleFlashScale>
				<indirectFirePenalty>0.3</indirectFirePenalty>
				<circularError>1</circularError>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
				</targetParams>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_Charges">
				<chargeSpeeds>
					<li>30</li>
					<li>50</li>
					<li>70</li>
					<li>90</li>
				</chargeSpeeds>
			</li>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>6</magazineSize>
				<reloadTime>10</reloadTime>
				<ammoSet>AmmoSet_UltraPlasmaShell</ammoSet>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="BaseArtilleryBuilding">
		<defName>ABT_Turret_AdvChargedArtillery</defName>
		<label>ultra plasma artillery</label>
		<size>(2,2)</size>
		<description>A plasma artillery piece for indirect fire at extended ranges.</description>
		<thingClass>CombatExtended.Building_TurretGunCE</thingClass>
		<constructionSkillPrerequisite>9</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/Turrets/AdvSpacer/AdvSpacer_base</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,0)</offset>
			</shadowData>
			<drawSize>(4,4)</drawSize>
		</graphicData>
		<uiIconPath>Things/Building/Turrets/AdvSpacer/Artillery_uiIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>600</MaxHitPoints>
			<Flammability>0.5</Flammability>
			<WorkToBuild>47000</WorkToBuild>
			<Mass>150</Mass>
			<Bulk>100</Bulk>
		</statBases>
		<costList>
			<Steel>350</Steel>
			<Plasteel>100</Plasteel>
			<ComponentIndustrial>7</ComponentIndustrial>
			<ComponentSpacer>1</ComponentSpacer>
		</costList>
		<costStuffCount />
		<building>
			<turretTopDrawSize>4</turretTopDrawSize>
			<turretGunDef>ABT_Gun_AdvChargeArtillery</turretGunDef>
			<ai_combatDangerous>true</ai_combatDangerous>
			<turretBurstCooldownTime>2.7</turretBurstCooldownTime>
		</building>
		<placeWorkers>
			<li>PlaceWorker_NotUnderRoof</li>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_PreventInteractionSpotOverlap</li>
		</placeWorkers>
		<fillPercent>0.85</fillPercent>
		<stuffCategories Inherit="False" />
		<terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
		<researchPrerequisites>
			<li>Bamba_Turret_Research_Ultra</li>
		</researchPrerequisites>
		<minifiedDef>MinifiedThing</minifiedDef>
		<designationCategory>Security</designationCategory>
		<interactionCellOffset>(0,0,-1)</interactionCellOffset>
	</ThingDef>

</Defs>
<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- ==================== Charge Microgun ==================== -->
	<!-- Fires CE's 8x35mm charged rifle round, the Spacer LMG round in AllBambaGuns. The 6x18mm pistol round it used before
	     left it with less damage per second than the industrial microgun. -->

	<ThingDef ParentName="BaseTurretGun">
		<defName>ABT_Gun_CM</defName>
		<label>charge microgun</label>
		<graphicData>
			<texPath>Things/Building/Turrets/Spacer/Gun</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>Automated charge-shot rotary machine gun for use against infantry and lightly armored targets.</description>
		<statBases>
			<Mass>8</Mass>
			<ShotSpread>0.08</ShotSpread>
			<SwayFactor>0.78</SwayFactor>
			<SightsEfficiency>1.5</SightsEfficiency>
			<RangedWeapon_Cooldown>0.35</RangedWeapon_Cooldown>
		</statBases>
		<verbs>
			<li Class="CombatExtended.VerbPropertiesCE">
				<recoilAmount>0.67</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_8x35mmCharged</defaultProjectile>
				<warmupTime>2.2</warmupTime>
				<range>62</range>
				<burstShotCount>25</burstShotCount>
				<ticksBetweenBurstShots>1</ticksBetweenBurstShots>
				<soundCast>Shot_ChargeBlaster</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
				<recoilPattern>Mounted</recoilPattern>
			</li>
		</verbs>
		<comps>
			<li Class="CombatExtended.CompProperties_AmmoUser">
				<magazineSize>1000</magazineSize>
				<reloadTime>9.2</reloadTime>
				<ammoSet>AmmoSet_8x35mmCharged</ammoSet>
			</li>
			<li Class="CombatExtended.CompProperties_FireModes">
				<aimedBurstShotCount>10</aimedBurstShotCount>
				<aiAimMode>Snapshot</aiAimMode>
			</li>
		</comps>
	</ThingDef>

	<ThingDef ParentName="TurretAutoBase">
		<defName>ABT_Turret_CM</defName>
		<label>charge microgun</label>
		<size>(2,2)</size>
		<constructionSkillPrerequisite>9</constructionSkillPrerequisite>
		<graphicData>
			<texPath>Things/Building/Turrets/Spacer/Spacer_base</texPath>
			<drawSize>(2,2)</drawSize>
			<shadowData>
				<volume>(0.27,0.25,0.4)</volume>
				<offset>(0,0,0)</offset>
			</shadowData>
		</graphicData>
		<uiIconPath>Things/Building/Turrets/Spacer/Gun_uiIcon</uiIconPath>
		<statBases>
			<MaxHitPoints>250</MaxHitPoints>
			<Flammability>0.5</Flammability>
			<WorkToBuild>38000</WorkToBuild>
			<Mass>15</Mass>
			<Bulk>30</Bulk>
			<AimingAccuracy>0.75</AimingAccuracy>
			<ShootingAccuracyTurret>1.25</ShootingAccuracyTurret>
			<NightVisionEfficiency>0.5</NightVisionEfficiency>
		</statBases>
		<description>Automated charge rotary machine gun mounted on a quadpod.</description>
		<costList>
			<Steel>175</Steel>
			<Plasteel>50</Plasteel>
			<ComponentIndustrial>7</ComponentIndustrial>
			<ComponentSpacer>1</ComponentSpacer>
		</costList>
		<building>
			<turretTopDrawSize>3</turretTopDrawSize>
			<turretGunDef>ABT_Gun_CM</turretGunDef>
			<ai_combatDangerous>true</ai_combatDangerous>
		</building>
		<placeWorkers>
			<li>PlaceWorker_TurretTop</li>
			<li>PlaceWorker_ShowTurretRadius</li>
		</placeWorkers>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<basePowerConsumption>300</basePowerConsumption>
			</li>
		</comps>
		<researchPrerequisites>
			<li>Bamba_Turret_Research_Spacer</li>
		</researchPrerequisites>
		<minifiedDef>MinifiedThing</minifiedDef>
	</ThingDef>

	<!-- ==================== Charge EMP ==================== -->

	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_8x35mmChargedIon</defName>
		<label>8x35mm Ion Charged</label>
		<ammoTypes>
			<Ammo_8x35mmCharged_Ion>Bullet_8x35mmCharged_IonP</Ammo_8x35mmCharged_Ion>
		</ammoTypes>
		<similarTo>AmmoSet_ChargedRifle</similarTo>
	</CombatExtended.AmmoSetDef>

	<ThingDef Name="Bullet_8x35mmCharged_Ion" ParentName="Base8x35mmChargedBullet">
		<defName>Bullet_8x35mmCharged_IonP</defName>
		<label>8x35mm Charged bullet (Ion)</label>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageAmountBase>15</damageAmountBase>
			<secondaryDamage>
				<li>
					<def>EMP</def>
					<amount>11</amount>
				</li>
			</secondaryDamage>
			<!-- Ion has the same penetration as the standard 8x35mm round; its job is the EMP. -->
			<armorPenetrationSharp>16</armorPenetrationSharp>
			<armorPenetrationBlunt>57.6</armorPenetrationBlunt>
			<empShieldBreakChance>0.67</empShieldBreakChance>
		</projectile>
	</ThingDef>


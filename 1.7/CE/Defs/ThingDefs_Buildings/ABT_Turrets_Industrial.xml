	<!-- CE's 105mm shells with 5x their world (crossmap) range: 30 to 150 tiles, the Anti shell 10 to 50.
	     Same ammo items as CE; only this turret fires these copies. Copied from CE with only defName and shellingProps range changed. -->
	<CombatExtended.AmmoSetDef>
		<defName>AmmoSet_105mmHowitzerShell_ABT</defName>
		<label>105mm howitzer shells</label>
		<ammoTypes>
			<Ammo_105mmHowitzerShell_HE>Bullet_105mmHowitzerShell_HE_ABT</Ammo_105mmHowitzerShell_HE>
			<Ammo_105mmHowitzerShell_HE_HFuzed>Bullet_105mmHowitzerShell_HE_HFuzed_ABT</Ammo_105mmHowitzerShell_HE_HFuzed>
			<Ammo_105mmHowitzerShell_Incendiary>Bullet_105mmHowitzerShell_Incendiary_ABT</Ammo_105mmHowitzerShell_Incendiary>
			<Ammo_105mmHowitzerShell_EMP>Bullet_105mmHowitzerShell_EMP_ABT</Ammo_105mmHowitzerShell_EMP>
			<Ammo_105mmHowitzerShell_Smoke>Bullet_105mmHowitzerShell_Smoke_ABT</Ammo_105mmHowitzerShell_Smoke>
			<Ammo_105mmHowitzerShell_Anti>Bullet_105mmHowitzerShell_Anti_ABT</Ammo_105mmHowitzerShell_Anti>
		</ammoTypes>
		<isMortarAmmoSet>true</isMortarAmmoSet>
		<similarTo>AmmoSet_ArtilleryShell</similarTo>
	</CombatExtended.AmmoSetDef>


	<!-- The cannon's bolt: a sharp plasma hit with a heat secondary, then a plasma burst. A plain CE bullet still fires its
	     explosive comp on impact. -->
	<ThingDef Name="ABT_UltraPlasmaBoltBase" ParentName="BaseBulletCE" Abstract="true">
		<graphicData>
			<texPath>Things/Projectile/ChargeLanceShot</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>TransparentPostLight</shaderType>
			<color>(0.45, 0.9, 1)</color>
			<drawSize>1.8</drawSize>
		</graphicData>
		<projectile Class="CombatExtended.ProjectilePropertiesCE">
			<damageDef>ABT_PlasmaBolt</damageDef>
			<speed>140</speed>
			<armorPenetrationSharp>70</armorPenetrationSharp>
			<armorPenetrationBlunt>160</armorPenetrationBlunt>
		</projectile>
	</ThingDef>


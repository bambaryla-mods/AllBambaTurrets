<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- Ultra turret ammo. The Ultra rung sits between Solar and Quasar (marines 46 / 110 against Solar 36 and Quasar 60).
	     Following AllBambaGuns: each line above Spacer has its own calibers, def names follow labels, and the sets have no
	     similarTo, so they keep their own ammo with CE's generic ammo setting on.
	     Charge rounds sit between the guns' Solar and Kwazaari charge LMG rounds: standard never goes through its own marine,
	     concentrated never through the next. Concentrated and Ion do 77% of standard damage.
	     Plasma follows the anti-armor rule: it beats the next marine (Quasar 60) and stops two rungs up (Orientis 80). -->

	<ThingCategoryDef>
		<defName>Ammo8x40mmUltraCharged</defName>
		<label>8x40mm Ultra Charged</label>
		<parent>AmmoAdvanced</parent>
		<iconPath>UI/Icons/ThingCategories/CaliberCharge</iconPath>
	</ThingCategoryDef>

	<ThingCategoryDef>
		<defName>AmmoUltraPlasmaCell</defName>
		<label>Ultra Plasma Cell</label>
		<parent>AmmoAdvanced</parent>
		<iconPath>UI/Icons/ThingCategories/CaliberPlasmaMedium</iconPath>
	</ThingCategoryDef>

	<ThingCategoryDef>
		<defName>AmmoUltraPlasmaShell</defName>
		<label>Ultra Plasma Shell</label>
		<parent>AmmoAdvanced</parent>
		<iconPath>UI/Icons/ThingCategories/CaliberPlasmaLarge</iconPath>
	</ThingCategoryDef>


	<ThingDef ParentName="BaseWeaponTurret">
		<defName>ABT_Gun_Microgun</defName>
		<label>microgun</label>
		<graphicData>
			<texPath>Things/Building/Turrets/Industrial/Gun</texPath>
			<graphicClass>Graphic_Single</graphicClass>
		</graphicData>
		<description>Automated rotary machine gun for use against infantry and lightly armored targets.</description>
		<statBases>
			<Mass>10</Mass>
			<AccuracyTouch>0.25</AccuracyTouch>
			<AccuracyShort>0.35</AccuracyShort>
			<AccuracyMedium>0.35</AccuracyMedium>
